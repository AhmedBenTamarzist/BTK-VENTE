# Database configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=quincaillerie_db

# JWT Secret
SECRET_KEY=super_secret_quincaillerie_key_12345

# Sauvegarde automatique de la base (dossier local + serveur SMTP technique -
# l'email d'envoi, le mot de passe et le destinataire se configurent depuis
# l'interface : Paramètres > Sauvegardes)
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=14
# Requis si pg_dump n'est pas dans le PATH, ex: C:\Program Files\PostgreSQL\16\bin\pg_dump.exe
PG_DUMP_PATH=pg_dump
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Synchronisation des articles avec Debot (app dépôt/stock séparée)
DEBOT_API_URL=https://gdstock.ddns.net/api
DEBOT_API_KEY=
